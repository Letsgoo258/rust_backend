      "title": "Top 10 Slowest SQL Queries (pg_stat_statements)",
      "type": "table",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": ""
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT LEFT(query, 75) AS \"Query\", calls AS \"Calls\", ROUND(mean_exec_time::numeric, 2) AS \"Avg Latency (ms)\", ROUND(max_exec_time::numeric, 2) AS \"Max (ms)\", rows AS \"Rows\" FROM pg_stat_statements WHERE query NOT LIKE '%pg_stat_statements%' ORDER BY mean_exec_time DESC LIMIT 10;",
          "refId": "A"
        }
      ]
