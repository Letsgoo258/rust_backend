  "query": "\n            SELECT u.id, u.school_id, u.username, u.password_hash, u.display_name\n            FROM users u\n            JOIN schools s ON u.school_id = s.id\n            WHERE s.code = $1 AND u.username = $2 AND u.status = 'ACTIVE' AND s.status = 'ACTIVE'\n            ",
